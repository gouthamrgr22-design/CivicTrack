# Google Identity Services Web client ID (public identifier)
GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com

# Resend email delivery (keep the API key secret in .env)
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM=CivicTrack <onboarding@resend.dev>

# CivicTrack origin used in verification links
CIVICTRACK_BASE_URL=http://127.0.0.1:8000
